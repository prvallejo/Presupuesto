                const m = Math.floor(n/1000000); const r = n%1000000;
                const t = m === 1 ? 'UN MILLÓN' : Centenas(m) + ' MILLONES';
                return r === 0 ? t : t + ' ' + miles(r);
            };
            const entero = Math.floor(num);
            const centavos = Math.round((num - entero) * 100);
            const texto = millones(entero);
            const sufijo = moneda === 'CLP' ? 'PESOS' : 'DÓLARES';
            return `SON: ${texto} ${sufijo} ${centavos > 0 ? `CON ${centavos}/100` : ''}.-`.toUpperCase();
        };

