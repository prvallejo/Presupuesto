                                <div className="flex-1 space-y-6">
                                    <div className="w-32 h-32 bg-slate-50 border-2 border-dashed border-slate-200 flex items-center justify-center relative no-print rounded-2xl group hover:border-blue-400 transition-all overflow-hidden">
