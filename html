                if (n === 100) return 'CIEN';
                if (n < 100) return Decenas(n);
                const c = Math.floor(n/100); const r = n%100;
                const t = ['','CIENTO','DOSCIENTOS','TRESCIENTOS','CUATROCIENTOS','QUINIENTOS','SESECIENTOS','SETECIENTOS','OCHOCIENTOS','NOVECIENTOS'][c];
