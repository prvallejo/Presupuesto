                        <button onClick={() => html2pdf().from(document.getElementById('presupuesto-pdf')).set({ margin: 5, filename: 'Presupuesto.pdf', image: { type: 'jpeg', quality: 0.98 }, html2canvas: { scale: 2 }, jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' } }).save()} className="bg-blue-600 hover:bg-blue-700 px-8 py-2.5 rounded-xl text-[11px] font-black uppercase shadow-lg shadow-blue-500/20 transition-all active:scale-95">Exportar PDF</button>
                    </nav>

                    <div className="flex flex-col items-center p-4 md:p-8">
