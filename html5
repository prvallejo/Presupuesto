};

const numeroALetras = (num, moneda) => {
  const Unidades = (n) => ['','UN','DOS','TRES','CUATRO','CINCO','SEIS','SIETE','OCHO','NUEVE'][n];
  const Decenas = (n) => {
    if (n<10) return Unidades(n);
    if (n<20) return ['DIEZ','ONCE','DOCE','TRECE','CATORCE','QUINCE','DIEZ Y SEIS','DIEZ Y SIETE','DIEZ Y OCHO','DIEZ Y NUEVE'][n-10];
    const d = Math.floor(n/10); const u = n%10;
    const t = ['','','VEINTE','TREINTA','CUARENTA','CINCUENTA','SESENTA','SETENTA','OCHENTA','NOVENTA'][d];
    return u === 0 ? t : (d === 2 ? 'VEINTI' : t + ' Y ') + Unidades(u);
  };
  const Centenas = (n) => {
    if (n === 100) return 'CIEN';
    if (n < 100) return Decenas(n);
    const c = Math.floor(n/100); const r = n%100;
    const t = ['','CIENTO','DOSCIENTOS','TRESCIENTOS','CUATROCIENTOS','QUINIENTOS','SEISCIENTOS','SETECIENTOS','OCHOCIENTOS','NOVECIENTOS'][c];
    return r === 0 ? t : t + ' ' + Decenas(r);
  };
  const miles = (n) => {
    if (n === 1000) return 'MIL';
    if (n < 1000) return Centenas(n);
    const m = Math.floor(n/1000); const r = n%1000;
    const t = m === 1 ? 'MIL' : Centenas(m) + ' MIL';
    return r === 0 ? t : t + ' ' + Centenas(r);
  };
  const millones = (n) => {
    if (n < 1000000) return miles(n);
    const m = Math.floor(n/1000000); const r = n%1000000;
    const t = m === 1 ? 'UN MILLÓN' : Centenas(m) + ' MILLONES';
    return r === 0 ? t : t + ' ' + miles(r);
  };
  const entero = Math.floor(num);
  const centavos = Math.round((num - entero) * 100);
  const texto = millones(entero);
  const sufijo = moneda === 'CLP' ? 'PESOS' : 'DÓLARES';
  return `SON: ${texto} ${sufijo} ${centavos > 0 ? `CON ${centavos}/100` : ''}.-`.toUpperCase();
};

