                    </div>
                    <div>
                       <label className="text-[9px] font-black text-slate-400 uppercase">Decimales Subtotal</label>
                       <input type="number" className="w-full p-2 border rounded-xl font-bold text-xs" value={config.decimalesSubtotal} onChange={e=>setConfig({...config, decimalesSubtotal: parseInt(e.target.value)})}/>
                    </div>
                    <div>
                       <label className="text-[9px] font-black text-slate-400 uppercase">Decimales Total</label>
                       <input type="number" className="w-full p-2 border rounded-xl font-bold text-xs" value={config.decimalesTotal} onChange={e=>setConfig({...config, decimalesTotal: parseInt(e.target.value)})}/>
                    </div>
                 </div>

                 <div className="flex gap-4 border-t pt-4">
                    <div className="flex-1">
                       <label className="text-[9px] font-black text-slate-400 uppercase">Utilidad (%)</label>
                       <input type="number" className="w-full p-2 border rounded-xl font-bold text-xs" value={globalUtil} onChange={e=>setGlobalUtil(e.target.value)}/>
                    </div>
                    <div className="flex-1">
                       <label className="text-[9px] font-black text-slate-400 uppercase">Gastos Grales (%)</label>
                       <input type="number" className="w-full p-2 border rounded-xl font-bold text-xs" value={globalGG} onChange={e=>setGlobalGG(e.target.value)}/>
                    </div>
                 </div>

                 <button onClick={()=>setActiveModal(null)} className="w-full bg-slate-900 text-white py-4 rounded-2xl font-black text-[10px] uppercase shadow-xl hover:bg-slate-800 transition-all">Guardar Configuración</button>
              </div>
           </div>
        </div>
      )}

      {/* OTROS MODALES */}
      {activeModal === 'cubicar' && <CubicarModal id={selectedId}/>}
      {activeModal === 'estudioGG' && <EstudioGGModal />}
      
      {activeModal === 'apu' && (
        <div className="fixed inset-0 bg-slate-900/95 z-[1000] flex items-center justify-center p-4">
           <div className="bg-white w-full max-w-md rounded-3xl overflow-hidden shadow-2xl">
              <div className="bg-orange-600 p-5 text-white flex justify-between items-center">
                <div className="flex items-center gap-2"><Briefcase size={16}/><h3 className="text-xs font-black uppercase tracking-widest">Ajuste de Precio Unitario</h3></div>
                <button onClick={()=>setActiveModal(null)}><X/></button>
              </div>
              <div className="p-10 text-center space-y-6">
                 <input type="number" className="text-5xl font-black text-center border-b-4 border-slate-900 outline-none w-full pb-2" value={items.find(i=>i.id===selectedId)?.precio} onChange={e=>updateItem(selectedId, 'precio', e.target.value)} />
                 <p className="text-[10px] text-slate-400 uppercase font-black tracking-widest">Valor Neto Unitario ({config.moneda})</p>
                 <button onClick={()=>setActiveModal(null)} className="bg-slate-900 text-white px-12 py-4 rounded-2xl font-black text-xs uppercase shadow-xl hover:scale-105 transition-all">Confirmar Precio</button>
              </div>
           </div>
        </div>
      )}

    </div>
  );
}

 
